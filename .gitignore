.env.local
.env.development
.env.production
.env.test
*.env
!.env.example

# API keys, tokens, credentials
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
service-account*.json
gha-creds-*.json

# Private keys
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.gpg
secrets/
credentials/

# ============================================================
