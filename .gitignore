# ============================================================
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
out/
release/

# Gradle
.gradle/
build/
local.properties
proguard/
*.iml
.idea/workspace.xml
.cxx/

# Android signing
*.jks
*.keystore
keystore.properties

# ============================================================
# NODE / WEB (Phase 1+)
# ============================================================
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Build output
dist/
build/
.next/
out/
.vite/
*.tsbuildinfo

# Vite
.vite/

# ============================================================
# IDE / EDITOR
# ============================================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.idea_modules/

# ============================================================
# OS / SYSTEM
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini
$TAGS

# ============================================================
